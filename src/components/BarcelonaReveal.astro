---
import barcelonaImg from '../assets/Barcelona.jpg';
---

<div class="hero-image" style={`--bg-url: url(${barcelonaImg.src})`}></div>
<div class="dark-overlay" id="overlay"></div>

<style>
  .hero-image {
    position: fixed;
    inset: 0;
    z-index: -2;
    background-image: var(--bg-url);
    background-size: cover;
    background-position: center;
    filter: brightness(0.5);
    pointer-events: none;
  }
  .dark-overlay {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: rgb(26, 23, 18);
    pointer-events: none;
    --mx: 50%;
    --my: 50%;
    --radius: 90px;
    -webkit-mask-image: radial-gradient(circle var(--radius) at var(--mx) var(--my), transparent 0%, rgba(0,0,0,0.05) 20%, rgba(0,0,0,0.2) 40%, rgba(0,0,0,0.45) 60%, rgba(0,0,0,0.75) 80%, black 100%);
    mask-image: radial-gradient(circle var(--radius) at var(--mx) var(--my), transparent 0%, rgba(0,0,0,0.05) 20%, rgba(0,0,0,0.2) 40%, rgba(0,0,0,0.45) 60%, rgba(0,0,0,0.75) 80%, black 100%);
  }
</style>

<script>
  const overlay = document.getElementById('overlay');
  let raf: number | null = null;
  window.addEventListener('mousemove', (e) => {
    if (raf) return;
    raf = requestAnimationFrame(() => {
      if (overlay) {
        overlay.style.setProperty('--mx', e.clientX + 'px');
        overlay.style.setProperty('--my', e.clientY + 'px');
      }
      raf = null;
    });
  });
</script>